# ── Database ───────────────────────────────────────────────
# Leave DATABASE_URL empty to use a local SQLite file (RAFIQ_DB). For production use PostgreSQL:
DATABASE_URL=postgresql://rafiq:change-this-db-password@db:5432/rafiq
RAFIQ_DB=/data/rafiq.db

# ── First administrator (created on first start if it doesn't exist) ──
RAFIQ_ADMIN_USER=admin
RAFIQ_ADMIN_PASSWORD=change-me-at-least-8-chars
# Or create one later:  python -m app.manage create-user --username me --name "Me" --role admin

# ── Web security ───────────────────────────────────────────
RAFIQ_COOKIE_SECURE=1        # 1 when served over HTTPS (always, in production)
RAFIQ_SESSION_HOURS=12
RAFIQ_CLINIC_NAME=المركز الصحي
RAFIQ_DEMO_SEED=0            # 1 = synthetic demo patients + well-known demo passwords. NEVER with real data.
RAFIQ_SCHEDULER=1

# ── WhatsApp Cloud API (leave empty to run without WhatsApp; web chat still works) ──
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=pick-a-random-string
WHATSAPP_APP_SECRET=         # REQUIRED in production: enables webhook signature checks

# ── Optional media understanding (untested without your credentials) ──
ANTHROPIC_API_KEY=
RAFIQ_VISION_MODEL=claude-sonnet-5-5
RAFIQ_STT_ENDPOINT=
RAFIQ_STT_KEY=
RAFIQ_STT_MODEL=whisper-1
