# ── What this installation is for ──────────────────────────
RAFIQ_PROGRAMME=chronic      # chronic = diabetes + blood-pressure monitoring (default) | breast = early breast-cancer detection | both

# ── Database ───────────────────────────────────────────────
# Leave DATABASE_URL empty to use a local SQLite file (RAFIQ_DB). For production use PostgreSQL:
DATABASE_URL=postgresql://rafiq:change-this-db-password@db:5432/rafiq
RAFIQ_DB=/data/rafiq.db

# ── First administrator (created on first start if it doesn't exist) ──
RAFIQ_ADMIN_USER=admin
RAFIQ_ADMIN_PASSWORD=change-me-at-least-8-chars
# Or create one later:  python -m app.manage create-user --username me --name "Me" --role admin

# ── Public sign-up (patients) ──────────────────────────────
RAFIQ_ALLOW_SIGNUP=1         # 0 = only staff can create patient accounts
RAFIQ_REQUIRE_INVITE=1       # 1 = a clinic code is required to register (recommended)
RAFIQ_VERIFY=auto            # auto | whatsapp | email | none.  auto picks WhatsApp, else email (SMTP), else none
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Rafiq <no-reply@your-clinic.example>
RAFIQ_ONCALL_PHONE=          # who gets an urgent alert if a patient has no assigned clinician (WhatsApp number)

# ── Doctor ↔ patient messaging ─────────────────────────────
RAFIQ_CLINIC_HOURS=08:00-16:00   # outside these hours (patient's local time) the automatic reply says when the clinic opens
RAFIQ_APP_URL=https://rafiq.your-clinic.example   # shown to doctors in the automatic WhatsApp digest

# ── Web security ───────────────────────────────────────────
RAFIQ_COOKIE_SECURE=1        # 1 when served over HTTPS (always, in production)
RAFIQ_SESSION_HOURS=12
# ── Who you are (shown on the login/sign-up pages and in every welcome / verification message) ──
RAFIQ_CLINIC_NAME=Amman Health Centre     # the real organisation that operates this service
RAFIQ_ORG_PHONE=+962 6 555 0000           # so users can call and verify you
RAFIQ_ORG_URL=www.your-clinic.example
RAFIQ_OFFICIAL=0                          # set to 1 ONLY if the service is genuinely run in that organisation's name.
                                          # Then messages say "an official service of <name>". Never used in demo mode.
RAFIQ_DEMO_SEED=0            # 1 = synthetic demo patients + well-known demo passwords. NEVER with real data.
RAFIQ_SCHEDULER=1

# ── WhatsApp Cloud API (leave empty to run without WhatsApp; the web chat still works) ──
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=pick-a-random-string
WHATSAPP_APP_SECRET=         # REQUIRED in production: enables webhook signature checks

# ── Optional media understanding (untested without your credentials) ──
ANTHROPIC_API_KEY=
RAFIQ_VISION_MODEL=claude-sonnet-5-5
RAFIQ_STT_ENDPOINT=
RAFIQ_STT_KEY=
RAFIQ_STT_MODEL=whisper-1
