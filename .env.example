# ── Dashboard ──────────────────────────────────────────────
RAFIQ_DASHBOARD_KEY=change-me-long-random-string   # REQUIRED in any real deployment
RAFIQ_DB=/data/rafiq.db
RAFIQ_CLINIC_NAME=المركز الصحي
RAFIQ_DEMO_SEED=0          # 1 = load synthetic demo patients on first start
RAFIQ_SCHEDULER=1

# ── WhatsApp Cloud API (leave empty to run in simulator mode) ──
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=pick-a-random-string
WHATSAPP_APP_SECRET=       # REQUIRED in production: enables webhook signature checks

# ── Optional media understanding (untested without your credentials) ──
ANTHROPIC_API_KEY=         # glucometer / BP-cuff photo reading (patient always confirms)
RAFIQ_VISION_MODEL=claude-sonnet-5-5
RAFIQ_STT_ENDPOINT=        # OpenAI-compatible /audio/transcriptions for voice notes
RAFIQ_STT_KEY=
RAFIQ_STT_MODEL=whisper-1
